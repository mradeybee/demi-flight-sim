{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demi-flight-sim",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FLIGHT_ROOM",
        "class_name": "FlightRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlightRoom"]
    }
  ]
}
