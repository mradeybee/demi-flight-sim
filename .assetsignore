# Wrangler uploads the project root as the site. Keep the Worker source,
# Node toolchain, and local junk off the public asset list.
.git
.wrangler
server
scripts
models/gear/_raw
**/.DS_Store
.env
.env.*
*.log

# The page needs the Three.js build plus the GLTF loader it imports.
node_modules/**
!node_modules/three/
!node_modules/three/build/
!node_modules/three/build/three.module.js
!node_modules/three/examples/
!node_modules/three/examples/jsm/
!node_modules/three/examples/jsm/loaders/
!node_modules/three/examples/jsm/loaders/GLTFLoader.js
!node_modules/three/examples/jsm/utils/
!node_modules/three/examples/jsm/utils/BufferGeometryUtils.js
!node_modules/three/examples/jsm/environments/
!node_modules/three/examples/jsm/environments/RoomEnvironment.js
